import
	keen/math/geom2d/aa-rect
	keen/math/vec
	../geometry

test
	a grid-rect =
		left: 0
		right: 1
		bottom: 0
		top: 2
	size a is 1, 2
	area a is 2

test
	# top-right is exclusive, so -5 through -2 contains -5, -4, -3 -- so center is -4
	# For positive numbers, 2 through 5 contains 2, 3, 4 -- so center is 3
	a grid-rect = bottom-left: (-5, 2), top-right: (-2, 5)
	center a is -4, 3

test
	unit aa-rect32 = bottom-left: (-0.5, -0.5), top-right: (0.5, 0.5)
	smallest-containing::grid-rect unit is
		bottom-left: -1, -1
		top-right: 1, 1

test
	a grid-rect = bottom-left: (1, 2), top-right: (4, 5)
	shrink a, 1 is bottom-left: (2, 3), top-right: (3, 4)
	shrink a, 2 is bottom-left: (2, 3), top-right: (2, 3)
	shrink a, 3 is bottom-left: (2, 3), top-right: (2, 3)
	shrink a, max-value is bottom-left: (2, 3), top-right: (2, 3)
	expand a, 1 is bottom-left: (0, 1), top-right: (5, 6)

test
	a grid-pos = 1, 2
	component-in-direction a, north is 2
	component-in-direction a, east is 1
	component-in-direction a, south is -2
	component-in-direction a, west is -1

test
	bounds grid-rect = bottom-left: (-3, -3), top-right: (3, 3)
	try-move-within bounds, bottom-left: (1, 1), top-right: (4, 4) is bottom-left: (0, 0), top-right: (3, 3)
	try-move-within bounds, bottom-left: (-3, 1), top-right: (5, 4) is bottom-left: (-4, 0), top-right: (4, 3)

test
	a grid-rect = bottom-left: (1, 2), top-right: (5, 4)
	positions = all-positions a
	positions.size is 8
	array grid-pos[] = map positions, {it}
	array is
		- 1, 2
		- 2, 2
		- 3, 2
		- 4, 2
		- 1, 3
		- 2, 3
		- 3, 3
		- 4, 3
	for i in 0 .. positions.size
		positions[i] is array[i]

test
	rotate-left::dir4 north is west
	rotate-left::dir4 west is south
	rotate-left::dir4 south is east
	rotate-left::dir4 east is north
	rotate-left::dir4 north, 2 is south
	rotate-left::dir4 north, 3 is east
	rotate-left::dir4 north, 23 is east

	rotate-right::dir4 north is east
	rotate-right::dir4 east is south
	rotate-right::dir4 south is west
	rotate-right::dir4 west is north
	rotate-right::dir4 west, 3 is south
	rotate-right::dir4 north, 123 is west

test
	left::relative-dir4 + right is forward

test
	a partial-bounds = left: 1
	b partial-bounds = left: 2
	a | b is left: 1
	a & b is left: 2
