import
	keen/parse
	../geometry
	../grid-set
	../grid-set-set
	../sparse-grid

test
	a grid-set-set = ()
	any a is false
	a.size is 0
	try
		_ = a[0]
		should-throw
	catch e as index-too-big
		e.actual is 0
		e.max-exclusive is 0
	show a is "empty"

test
	try
		_ grid-set-set =
			- ()
		should-throw
	catch as exception
		()

test
	a grid-set-set = ((0, 0),), ((1, 0),)
	a is ((1, 0),), ((0, 0),)

test
	try
		_ grid-set-set =
			- (0, 0),
			- (0, 0),
		should-throw
	catch as exception
		()

test
	a grid-set-set =
		- (0, 0), (0, 1)
		- (1, 0), (1, 1)
	show a is quote
		0, 0 to 2, 2
		AB
		AB
	parse grid-set-set, show a is a
	any a is true
	size a is 2
	a[0] is (0, 0), (0, 1)
	a[1] is (1, 0), (1, 1)
	which-set a, (0, 1) is 0
	which-set a, (1, 0) is 1
	which-set a, (1, 2) is ()

	any a, (1, 0) is true
	any a, (1, 2) is false

	remove-set a, 0 is ((1, 0), (1, 1)),

	try-move a, 0, east is ()
	try-move a, 0, north is
		- (0, 1), (0, 2)
		- (1, 0), (1 ,1)

	contains-all a, ((0, 0), (1, 1)) is true
	contains-all a, ((0, 0), (1, 2)) is false

test
	a grid-set =
		- 0, 0
		- 2, 0
		- 0, 1
		- 3, 0
	to-contiguous-grid-sets a is
		- (0, 0), (0, 1)
		- (2, 0), (3, 0)

test
	a grid-set-set =
		- (0, 0), (1, 0)
		- (0, 2), (1, 2)
	grid nat16 sparse-grid =
		- (0, 0), 0
		- (1, 0), 0
		- (0, 2), 1
		- (1, 2), 1
	to-indices-grid::(nat16 sparse-grid) a is grid
	from-indices-grid grid is a
