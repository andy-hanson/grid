import
	../../geometry
	../../grid-set
	../../sparse-grid
	../../util/betweenness-centrality
	keen/parse

test
	betweenness-centrality () is ()

test
	betweenness-centrality ((0, 0),) is
		- (0, 0), 0

test
	a grid-set = parse grid-set, quote
		0, 0 to 2, 1
		••
	betweenness-centrality a is
		- (0, 0), 0
		- (1, 0), 0

	interactive-betweenest a, 0 is ()
	interactive-betweenest a, 1 is (0, 0),
	interactive-betweenest a, 2 is (0, 0), (1, 0)
	try
		_ = interactive-betweenest a, 3
		should-throw
	catch e as index-too-big
		e.actual is 3
		e.max-exclusive is 3

test
	a grid-set = parse grid-set, quote
		0, 0 to 3, 1
		• •
	betweenness-centrality a is
		- (0, 0), 0
		- (2, 0), 0

test
	a grid-set = parse grid-set, quote
		0, 0 to 4, 2
		•• •
		•  •
	betweenness-centrality a is
		- (0, 0), 0
		- (3, 0), 0
		- (0, 1), 2
		- (1, 1), 0
		- (3, 1), 0
	interactive-betweenest a, 1 is (0, 1),
	interactive-betweenest a, 2 is (0, 1), (0, 0)

test
	a grid-set = parse grid-set, quote
		0, 0 to 3, 1
		•••
	betweenness-centrality a is
		- (0, 0), 0
		- (1, 0), 2
		- (2, 0), 0

test
	a grid-set = parse grid-set, quote
		0, 0 to 4, 1
		••••
	betweenness-centrality a is
		- (0, 0), 0
		- (1, 0), 4
		- (2, 0), 4
		- (3, 0), 0
	interactive-betweenest a, 2 is (1, 0), (0, 0)

test
	a grid-set = parse grid-set, quote
		0, 0 to 2, 2
		••
		••
	betweenness-centrality a is
		- (0, 0), 1
		- (1, 0), 1
		- (0, 1), 1
		- (1, 1), 1

test
	a grid-set = parse grid-set, quote
		0, 0 to 3, 3
		 •
		•••
		 •
	betweenness-centrality a is
		- (1, 0), 0
		- (0, 1), 0
		- (1, 1), 12
		- (2, 1), 0
		- (1, 2), 0

test
	a grid-set = parse grid-set, quote
		0, 0 to 5, 3
		 • •
		•••••
		 • •
	betweenness-centrality a is
		- (1, 0), 0
		- (3, 0), 0
		- (0, 1), 0
		- (1, 1), 36
		- (2, 1), 32
		- (3, 1), 36
		- (4, 1), 0
		- (1, 2), 0
		- (3, 2), 0
	interactive-betweenest a, 2 is (1, 1), (3, 1)

test
	a grid-set = parse grid-set, quote
		0, 0 to 3, 3
		•••
		• •
		•••
	betweenness-centrality a is
		- (0, 0), 9
		- (1, 0), 9
		- (2, 0), 9
		- (2, 1), 9
		- (2, 2), 9
		- (1, 2), 9
		- (0, 2), 9
		- (0, 1), 9

test
	a grid-set = parse grid-set, quote
		0, 0 to 4, 4
		• •
		• ••
		•••
		 ••
	betweenness-centrality a is
		- (1, 0), 4
		- (2, 0), 4
		- (0, 1), 28
		- (1, 1), 40
		- (2, 1), 40
		- (0, 2), 16
		- (2, 2), 30
		- (3, 2), 0
		- (0, 3), 0
		- (2, 3), 0
	interactive-betweenest a, 3 is (1, 1), (2, 2), (2, 0)
