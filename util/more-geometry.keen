import
	keen/math/geom2d/circle
	keen/math/math
	keen/math/vec
	../geometry
	../grid-set

+angle-to float32(a grid-pos, b grid-pos)
	angle b.to::vec2-32 - a.to::vec2-32

| Find the furthest point in the direction. Assumes no ties.
| Returns empty option only for an empty set.
+furthest grid-pos?(a grid-set, dir dir4)
	max-by a, {component-in-direction it, dir}

| Position in {a} nearest to {to}
+nearest-to grid-pos?(a grid-set, to grid-pos)
	min-by a, {distance-squared it, to}
| Position in {a} nearest to any position in {to}
+nearest-to grid-pos?(a grid-set, to grid-set)
	do if any a and any to
	min-by a, {distance-squared to, it}
| Position in {a} furthest from {from}
+furthest-from grid-pos?(a grid-set, from grid-pos)
	max-by a, {distance-squared it, from}
| Position in {a} furthest from {from}
+furthest-from grid-pos?(a grid-set, from grid-set)
	max-by a, {distance-squared from, it}

| If two positions are equally close, prefers the first one in the iteration order of {a}
+nearest grid-pos?(a grid-set, pos grid-pos)
	min-by a, {distance it, pos}
| Returns {infinity} if {a} is empty
+distance-to-nearest float32(a grid-set, pos grid-pos)
	if x = nearest a, pos
		distance x, pos
	else
		infinity

| Finds the point nearest to {pos} that is *not* in {a}.
+nearest-outside grid-pos(a grid-set, pos grid-pos)
	nearest! a.bounds.expand.to::grid-set - a, pos

| Square of the distance between the nearest points.
| Empty option if either input set is empty.
+distance-squared nat32?(a virtual-grid-set, b virtual-grid-set)
	match a
	as grid-pos
		match b
		as grid-pos
			distance-squared a, b
		else
			distance-squared-impl b.to::grid-set, a
	else
		a-set = to::grid-set a
		match b
		as grid-pos
			distance-squared-impl a-set, b
		else
			b-set = to::grid-set b
			do if any a-set and any b-set
			min-of a-set, of pos
				min-of! b-set, of pos2
					distance-squared pos, pos2
-distance-squared-impl nat32?(a grid-set, b grid-pos)
	min-of a, of pos
		distance-squared b, pos
+distance float?(a virtual-grid-set, b virtual-grid-set)
	if d = distance-squared a, b
		square-root to::float d

| Returns all positions whose center is inside the circle.
+positions-inside grid-set(circle circle32)
	radius-squared = circle.radius ** 2
	box grid-rect = center: circle.center.to, size: square circle.radius.round-up.to * 2 + 1
	make box, of pos
		(length-squared pos.to::vec2-32 - circle.center) <= radius-squared

| Does not include {a}. Does include {b}.
+line-of-sight record(a grid-pos, b grid-pos)
+some bool(a line-of-sight, f bool mut(pos grid-pos))
	some (line-of-sight-exclusive a.a, a.b), f or f[a.b]

| dir4 that most closely approximates the direction from {from} to {to}
+nearest-dir4-to dir4(from grid-pos, to grid-pos)
	diff = to - from
	if diff.x.abs > diff.y.abs
		if diff.x < 0 then west else east
	else
		if diff.y < 0 then south else north

+line-of-sight-inclusive record(a grid-pos, b grid-pos)
-exclusive line-of-sight-exclusive(a line-of-sight-inclusive) = a.a, a.b
+to grid-set(a line-of-sight-inclusive) = map a, {it}
+to grid-pos[](a line-of-sight-inclusive) = map a, {it}
+size nat32(a line-of-sight-inclusive)
	if a.a == a.b
		1
	else
		2 + size exclusive a
+some bool(a line-of-sight-inclusive, f bool mut(pos grid-pos))
	f[a.a] or a.a != a.b and (some a.exclusive, f or f[a.b])

| Iterates all tiles that can block a line of sight.
| Does not include {a} or {b}.
| Note: You can't look directly through a diagnoal.
+line-of-sight-exclusive record(a grid-pos, b grid-pos)
+to grid-set(a line-of-sight-exclusive) = map a, {it}
+to grid-pos[](a line-of-sight-exclusive) = map a, {it}
+size nat32(a line-of-sight-exclusive) = sum a, {1}
+some bool(a line-of-sight-exclusive, f bool mut(pos grid-pos))
	diff = a.b - a.a
	nx float32 = to abs diff.x
	ny float32 = to abs diff.y
	signx int16 = if diff.x > 0 then 1 else -1
	signy int16 = if diff.y > 0 then 1 else -1
	x mut = a.a.x
	y mut = a.a.y
	fx mut float32 = 0
	fy mut float32 = 0
	until
		do if fx < nx or fy < ny else false
		decision float32 = (1 + 2 * fx) * ny - (1 + 2 * fy) * nx
		on-diagonal = match decision <=> 0
		as less
			x +:= signx
			fx +:= 1
			false
		as equal
			# Exactly across a diagonal. Include both sides.
			x +:= signx
			y +:= signy
			fx +:= 1
			fy +:= 1
			f[x - signx, y] or f[x, y - signy]
		as greater
			y +:= signy
			fy +:= 1
			false
		if on-diagonal
			true
		elif fx == nx and fy == ny
			false
		elif f[x, y]
			true

| Walks a thin line between {a} and {b}, including both endpoints.
+line-inclusive record(a grid-pos, b grid-pos)
-exclusive line-exclusive(a line-inclusive) = a.a, a.b
+size nat32(a line-inclusive)
	if a.a == a.b
		1
	else
		2 + size exclusive a
+to grid-set(a line-inclusive) = map a, {it}
+to grid-pos[](a line-inclusive) = map a, {it}
+some bool(a line-inclusive, f bool mut(x grid-pos))
	f[a.a] or a.a != a.b and (some a.exclusive, f or f[a.b])

| Walks a thin line between {a} and {b}, excluding both endpoints.
+line-exclusive record(a grid-pos, b grid-pos)
+size nat32(a line-exclusive)
	dist = diagonal-distance a.a, a.b
	if dist == 0 then 0 else dist - 1
+to grid-set(a line-exclusive) = map a, {it}
+to grid-pos[](a line-exclusive) = map a, {it}
+some bool(a line-exclusive, f bool mut(x grid-pos))
	# https://www.redblobgames.com/grids/line-drawing/
	n = diagonal-distance a.a, a.b
	do unless n == 0
	some 1 .. n, of step
		point = round-point lerp a.a.to, a.b.to, step.to / n.to
		f[point]
-diagonal-distance nat16(from grid-pos, to grid-pos)
	diff = to - from
	max diff.x.abs, diff.y.abs
-round-point grid-pos(a vec2-32)
	x: to round a.x
	y: to round a.y
test
	line-to = of::grid-pos[] x grid-pos
		to line-exclusive (0, 0), x
	line-to[0, 0] is ()
	line-to[1, 0] is ()
	line-to[2, 0] is (1, 0),
	line-to[1, 1] is ()
	line-to[2, 1] is (1, 1),
	line-to[2, 2] is (1, 1),
	line-to[1, 2] is (1, 1),
	line-to[0, 2] is (0, 1),
	line-to[-2, 3] is (-1, 1), (-1, 2)
	line-to[-4, -2] is (-1, -1), (-2, -1), (-3, -2)
	line-to[5, -2] is (1, 0), (2, -1), (3, -1), (4, -2)

+grid-line-segment record(a grid-pos, b grid-pos)
+center grid-pos(a grid-line-segment)
	x: (a.a.x + a.b.x) / 2
	y: (a.a.y + a.b.y) / 2
+displacement grid-displacement(a grid-line-segment)
	a.b - a.a
+length float32(a grid-line-segment)
	square-root a.length-squared.to
+length-squared nat32(a grid-line-segment)
	length-squared a.displacement
+distance-to-line float32(line grid-line-segment, point grid-pos)
	square-root to distance-squared-to-line line, point
+distance-squared-to-line nat32(line grid-line-segment, point grid-pos)
	l2 = length-squared line
	base = point - line.a
	if l2 == 0 # Line is a point
		length-squared base
	else
		(cross-squared base, line.displacement) / l2

+ray4 record(origin grid-pos, dir dir4)
+subscript bool(a ray4, pos grid-pos)
	match a.dir
	as north
		pos.x == a.origin.x and pos.y >= a.origin.y
	as east
		pos.y == a.origin.y and pos.x >= a.origin.x
	as south
		pos.x == a.origin.x and pos.y <= a.origin.y
	as west
		pos.y == a.origin.y and pos.x <= a.origin.x

+segment-within ray4-segment(a ray4, set virtual-grid-set)
	pos mut = a.origin
	distance mut nat16 = 0
	while set[pos]
		pos := pos + a.dir
		distance +:= 1
	a, distance

| The ray does not include the endpoint, so a 0-distance ray includes 0 points.
+ray4-segment record(ray ray4, distance nat16)
+ray4-segment ray4-segment(origin grid-pos, dir dir4, distance nat16) = (origin, dir), distance
+any bool(a ray4-segment)
	a.distance != 0
+origin grid-pos(a ray4-segment) = a.ray.origin
+endpoint grid-pos(a ray4-segment)
	a.ray.origin + a.ray.dir.to::grid-displacement * a.distance.to::int16
+dir dir4(a ray4-segment) = a.ray.dir
+subscript bool(a ray4-segment, pos grid-pos)
	do if a.ray[pos]
	distance nat16 = match a.dir
	as north
		to pos.y - a.origin.y
	as east
		to pos.x - a.origin.x
	as south
		to a.origin.y - pos.y
	as west
		to a.origin.x - pos.x
	distance < a.distance
+size nat(a ray4-segment)
	a.distance
+some bool(a ray4-segment, f bool mut(x grid-pos))
	cur mut = a.origin
	distance mut nat16 = 0
	until
		if distance == a.distance
			false
		elif f[cur]
			true
		else
			cur := cur + a.dir
			distance +:= 1
			()
+tail ray4-segment(a ray4-segment)
	do if any a else a
	ray4-segment a.origin + a.dir, a.dir, a.distance - 1

| Returns the distance travelled if the ray reached the destination
+reaches nat16?(a ray4-segment, destination grid-pos, blocks virtual-grid-set)
	do if a[destination]
	distance mut nat16 = 0
	res bool? = first a, of pos
		if blocks[pos]
			false
		elif pos == destination
			true
		else
			distance +:= 1
			()
	if res == true then distance

| Returns a list of points that form a polygon.
| This is the convex hull in clockwise order starting from the leftmost point.
+convex-hull grid-pos[](positions grid-set)
	array grid-pos[] = positions.to
	res grid-pos mut[] = (min-by! array, it.x),
	until
		prev = peek! res
		endpoint mut = array[0]
		for candidate in array
			prefer = endpoint == prev or
				cross = cross (endpoint - prev), (candidate - prev)
				cross > 0 or cross == 0 and
					# For colinear points, use the one further away (to keep the result minimal)
					(manhattan-distance candidate, prev) > (manhattan-distance endpoint, prev)
			if prefer
				endpoint := candidate
		if endpoint == res[0]
			true
		else
			res ~= endpoint
			false
	move-to res

| Minimal convex polygon containing all points.
+filled-in-convex-hull grid-set(points grid-set)
	hull-points = convex-hull points
	hull-lines grid-set = union_ 0 .. hull-points.size, of i
		p0 = hull-points[if i == 0 then hull-points.size - 1 else i - 1]
		p1 = hull-points[i]
		to line-inclusive p0, p1
	fill-in-holes hull-lines

| Fills in any points that are completely surrounded by {a}.
| That means points whree there is no way to get outside by walking in {dir4}s.
+fill-in-holes grid-set(a grid-set)
	make a.bounds, of pos
		a[pos] or
			(some a.bounds.left .. pos.x, {a[it, pos.y]}) and
			(some pos.x + 1 .. a.bounds.right, {a[it, pos.y]}) and
			(some a.bounds.bottom .. pos.y, {a[pos.x, it]}) and
			(some pos.y + 1 .. a.bounds.top, {a[pos.x, it]})
